<div class="page-section" style="background: var(--c-{{ section.settings.background }});">
  <div class="container" style="padding-top: {{ section.settings.padding }}px; padding-bottom: {{ section.settings.padding }}px;">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Liquid personnalisé",
  "tag": "section",
  "class": "section-custom-liquid",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Code Liquid", "info": "Ajoutez des extraits d'applications ou du code Liquid." },
    { "type": "select", "id": "background", "label": "Fond", "options": [
      { "value": "cream", "label": "Crème" }, { "value": "white", "label": "Blanc" }
    ], "default": "cream" },
    { "type": "range", "id": "padding", "label": "Marges verticales", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Liquid personnalisé" } ]
}
{% endschema %}
