{%- liquid
  assign ss = section.settings
  assign section_bg = 'var(--c-white)'
  if ss.background == 'cream'
    assign section_bg = 'var(--c-cream)'
  endif
-%}
<div class="reviews{% if ss.show_scallop %} has-scallop{% endif %}" style="--section-bg: {{ section_bg }};">
  <div class="reviews__head">
    {%- if ss.eyebrow != blank -%}<span class="eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
    {%- if ss.heading != blank -%}<h2 class="reviews__title">{{ ss.heading }}</h2>{%- endif -%}
    {%- if ss.text != blank -%}<p class="reviews__text">{{ ss.text }}</p>{%- endif -%}
    {%- if ss.summary_rating != blank or ss.summary_stat != blank -%}
      <div class="reviews__summary">
        <span class="stars" aria-hidden="true">{{ ss.summary_stars }}</span>
        {%- if ss.summary_rating != blank -%}<span>{{ ss.summary_rating }}</span>{%- endif -%}
        {%- if ss.summary_rating != blank and ss.summary_stat != blank -%}<span class="reviews__summary-sep" aria-hidden="true">·</span>{%- endif -%}
        {%- if ss.summary_stat != blank -%}<span>{{ ss.summary_stat }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="reviews__viewport">
      <div class="reviews__track" style="--marquee-duration: {{ ss.duration }}s;">
        {%- for n in (1..2) -%}
          <div class="reviews__group"{% if n == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- assign bs = block.settings -%}
              <blockquote class="review-card u-{{ bs.univers }}" {% if n == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <div class="review-card__top">
                  <span class="review-card__stars" aria-label="{{ bs.stars | size }} / 5">{{ bs.stars }}</span>
                  <span class="review-card__mark" aria-hidden="true">”</span>
                </div>
                <p class="review-card__text">{{ bs.text }}</p>
                <footer class="review-card__foot">
                  {%- render 'media', image: bs.avatar, ph: 'beige', class: 'review-card__avatar', tag: 'span', sizes: '40px', widths: '40, 80' -%}
                  <span class="review-card__who">
                    <span class="review-card__name">{{ bs.author }}</span>
                    {%- if bs.verified != blank -%}<span class="review-card__verified">{{ bs.verified }}</span>{%- endif -%}
                  </span>
                </footer>
              </blockquote>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if ss.show_scallop -%}
    <div class="scallop" style="--scallop: {{ ss.scallop_color }};"></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Avis vérifiés" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Ce qu'en disent <em>les familles</em>" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des parents qui cherchaient une alternative aux boissons sucrées, et des enfants qui redemandent leur infusion." },
    { "type": "text", "id": "summary_stars", "label": "Étoiles du résumé", "default": "★★★★★" },
    { "type": "text", "id": "summary_rating", "label": "Note globale", "default": "4,9/5 sur 128 avis" },
    { "type": "text", "id": "summary_stat", "label": "Statistique", "default": "93 % des enfants réclament leur saveur" },
    { "type": "range", "id": "duration", "label": "Vitesse du défilement (desktop)", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60 },
    { "type": "select", "id": "background", "label": "Fond", "options": [
      { "value": "white", "label": "Blanc" }, { "value": "cream", "label": "Crème" }
    ], "default": "white" },
    { "type": "checkbox", "id": "show_scallop", "label": "Festons en bas de section", "default": false },
    { "type": "color", "id": "scallop_color", "label": "Couleur des festons (section suivante)", "default": "#FFF7EC" },
    { "type": "paragraph", "content": "Ces avis sont éditables ici. Vous pouvez aussi ajouter un bloc d'application d'avis (Judge.me, Loox…) dans une autre section." }
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "text", "id": "stars", "label": "Étoiles", "default": "★★★★★" },
      { "type": "textarea", "id": "text", "label": "Avis", "default": "« Ma fille de 5 ans réclame sa \"boisson de fruits\" au goûter. Le sirop est resté au placard depuis. »" },
      { "type": "text", "id": "author", "label": "Auteur", "default": "Camille, maman de 2 enfants" },
      { "type": "text", "id": "verified", "label": "Mention", "default": "✓ Achat vérifié" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar" },
      { "type": "select", "id": "univers", "label": "Couleur de la carte", "options": [
        { "value": "sunshine", "label": "Jaune" }, { "value": "adventure", "label": "Rouge" }, { "value": "forest", "label": "Violet" }, { "value": "bottle", "label": "Vert" }
      ], "default": "sunshine" }
    ] }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "text": "« Le kit était le bon départ : ils ont goûté les trois, chacun a élu sa saveur. La bouteille part tous les jours à l'école. »", "author": "Sofiane, papa de jumeaux", "univers": "forest" } },
        { "type": "review", "settings": { "text": "« Glacée en été, chaude en hiver : c'est devenu notre moment de fin de journée, sans discussion sur le sucre. »", "author": "Élodie, maman d'un garçon de 8 ans", "univers": "sunshine" } }
      ]
    }
  ]
}
{% endschema %}
