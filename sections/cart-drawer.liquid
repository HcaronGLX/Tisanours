{%- liquid
  assign ss = section.settings
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  assign progress = 100
  if threshold > 0 and cart.total_price < threshold
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif

  assign show_upsell = false
  if ss.upsell_product != blank and cart.item_count > 0
    assign show_upsell = true
    for item in cart.items
      if item.product_id == ss.upsell_product.id
        assign show_upsell = false
      endif
      for excluded in ss.upsell_exclude
        if item.product_id == excluded.id
          assign show_upsell = false
        endif
      endfor
    endfor
  endif
-%}
<div class="cart-drawer" data-cart-drawer data-section-id="{{ section.id }}" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ ss.title | escape }}" data-cart-count="{{ cart.item_count }}">
    <div class="cart-drawer__head">
      <span class="cart-drawer__title">{{ ss.title }}</span>
      <span class="cart-drawer__count">{{ cart.item_count }}</span>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'cart.close' | t }}">✕</button>
    </div>

    <div class="cart-drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <span class="cart-empty__title">{{ ss.empty_title }}</span>
          {%- if ss.empty_text != blank -%}<p class="cart-empty__text">{{ ss.empty_text }}</p>{%- endif -%}
          {%- render 'button', label: ss.empty_button_label, link: ss.empty_button_link, style: 'red' -%}
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index, once_label: ss.once_label -%}
        {%- endfor -%}

        {%- if show_upsell -%}
          {%- assign up = ss.upsell_product -%}
          {%- assign up_variant = up.selected_or_first_available_variant -%}
          <div class="cart-upsell">
            {%- render 'media', image: up.featured_image, class: 'cart-upsell__thumb ph--bottle', tag: 'span', sizes: '56px', widths: '56, 112' -%}
            <span class="cart-upsell__info">
              <span class="cart-upsell__label">{{ ss.upsell_label }}</span>
              <span class="cart-upsell__name">{{ ss.upsell_name | default: up.title }} · {{ up.price | money }}</span>
            </span>
            {%- if up_variant.available -%}
              <button type="button" class="btn btn--dark" data-quick-add="{{ up_variant.id }}">{{ ss.upsell_button }}</button>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      <p class="cart-error" data-cart-error role="alert"></p>
    </div>

    <div class="cart-drawer__foot">
      {%- if threshold > 0 -%}
        <div class="ship-bar">
          <span class="ship-bar__msg">
            {%- if remaining > 0 -%}
              {{ ss.shipping_remaining | replace: '[montant]', remaining_money }}
            {%- else -%}
              {{ ss.shipping_done }}
            {%- endif -%}
          </span>
          <span class="ship-bar__track"><span class="ship-bar__fill" style="width: {{ progress }}%;"></span></span>
        </div>
      {%- endif -%}
      <div class="cart-total">
        <span class="cart-total__label">{{ 'cart.total' | t }}</span>
        <span class="cart-total__value">{{ cart.total_price | money }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--red cart-drawer__checkout"{% if cart.item_count == 0 %} disabled{% endif %}>{{ ss.checkout_label }}</button>
      </form>
      {%- if ss.note != blank -%}<p class="cart-drawer__note">{{ ss.note }}</p>{%- endif -%}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Panier latéral",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Mon panier" },
    { "type": "text", "id": "once_label", "label": "Mention des produits sans variante", "default": "Achat unique" },
    { "type": "header", "content": "Panier vide" },
    { "type": "text", "id": "empty_title", "label": "Titre", "default": "Votre panier est vide" },
    { "type": "textarea", "id": "empty_text", "label": "Texte", "default": "Commencez par le Kit Démarrage Rituel : les 3 saveurs, la gourde infuseur et le Petit Guide du Rituel." },
    { "type": "text", "id": "empty_button_label", "label": "Texte du bouton", "default": "Découvrir le Kit Rituel" },
    { "type": "url", "id": "empty_button_link", "label": "Lien du bouton" },
    { "type": "header", "content": "Produit complémentaire" },
    { "type": "product", "id": "upsell_product", "label": "Produit proposé (gourde)" },
    { "type": "product_list", "id": "upsell_exclude", "label": "Masquer si l'un de ces produits est au panier", "info": "Ex. le Kit, qui contient déjà la gourde.", "limit": 5 },
    { "type": "text", "id": "upsell_label", "label": "Sur-titre", "default": "Complétez le rituel" },
    { "type": "text", "id": "upsell_name", "label": "Nom affiché", "default": "Gourde infuseur" },
    { "type": "text", "id": "upsell_button", "label": "Texte du bouton", "default": "Ajouter" },
    { "type": "header", "content": "Livraison offerte" },
    { "type": "paragraph", "content": "Le seuil se règle dans Paramètres du thème > Panier." },
    { "type": "text", "id": "shipping_remaining", "label": "Message avant le seuil", "info": "[montant] est remplacé par la somme restante.", "default": "Plus que [montant] pour la livraison offerte" },
    { "type": "text", "id": "shipping_done", "label": "Message seuil atteint", "default": "Livraison offerte, c'est acquis !" },
    { "type": "header", "content": "Validation" },
    { "type": "text", "id": "checkout_label", "label": "Texte du bouton", "default": "Passer commande" },
    { "type": "text", "id": "note", "label": "Mentions de réassurance", "default": "Paiement sécurisé · Satisfait ou remboursé 30 jours" }
  ]
}
{% endschema %}
