{%- liquid
  assign ss = section.settings
-%}
<div class="cart-drawer" data-cart-drawer data-section-id="{{ section.id }}" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ ss.title | escape }}" data-cart-count="{{ cart.item_count }}">
    <div class="cart-drawer__head">
      <span class="cart-drawer__title">{{ ss.title }}</span>
      <span class="cart-drawer__count">{{ cart.item_count }}</span>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'cart.close' | t }}">✕</button>
    </div>

    <div class="cart-drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <span class="cart-empty__title">{{ ss.empty_title }}</span>
          {%- if ss.empty_text != blank -%}<p class="cart-empty__text">{{ ss.empty_text }}</p>{%- endif -%}
          {%- render 'button', label: ss.empty_button_label, link: ss.empty_button_link, style: 'red' -%}
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index, once_label: ss.once_label -%}
        {%- endfor -%}

        {%- render 'cart-upsells' -%}
      {%- endif -%}
      <p class="cart-error" data-cart-error role="alert"></p>
    </div>

    <div class="cart-drawer__foot">
      {%- render 'cart-tiers' -%}
      <div class="cart-total">
        <span class="cart-total__label">{{ 'cart.total' | t }}</span>
        <span class="cart-total__value">{{ cart.total_price | money }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--red cart-drawer__checkout"{% if cart.item_count == 0 %} disabled{% endif %}>{{ ss.checkout_label }}</button>
      </form>
      {%- if ss.note != blank -%}<p class="cart-drawer__note">{{ ss.note }}</p>{%- endif -%}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Panier latéral",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Mon panier" },
    { "type": "text", "id": "once_label", "label": "Mention des produits sans variante", "default": "Achat unique" },
    { "type": "header", "content": "Panier vide" },
    { "type": "text", "id": "empty_title", "label": "Titre", "default": "Votre panier est vide" },
    { "type": "textarea", "id": "empty_text", "label": "Texte", "default": "Commencez par le Kit Démarrage Rituel : les 3 saveurs, la gourde infuseur et le Petit Guide du Rituel." },
    { "type": "text", "id": "empty_button_label", "label": "Texte du bouton", "default": "Découvrir le Kit Rituel" },
    { "type": "url", "id": "empty_button_link", "label": "Lien du bouton" },
    { "type": "header", "content": "Produits complémentaires" },
    { "type": "paragraph", "content": "Les suggestions du panier se règlent dans Paramètres du thème > Panier et, produit par produit, avec le métachamp « Produits complémentaires (panier) »." },
    { "type": "header", "content": "Paliers à débloquer" },
    { "type": "paragraph", "content": "Les paliers et leurs messages se règlent dans Paramètres du thème > Panier." },
    { "type": "header", "content": "Validation" },
    { "type": "text", "id": "checkout_label", "label": "Texte du bouton", "default": "Passer commande" },
    { "type": "text", "id": "note", "label": "Mentions de réassurance", "default": "Paiement sécurisé · Satisfait ou remboursé 30 jours" }
  ]
}
{% endschema %}
