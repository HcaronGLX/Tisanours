<div class="page-section">
  <div class="page-section__inner" style="max-width: 560px;">
    <h1 class="page-title">{{ 'customer.reset.title' | t }}</h1>
    <div class="card-box" style="margin-top: 24px;">
      {%- form 'reset_customer_password', class: 'form' -%}
        {%- if form.errors -%}<div class="form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field">{{ 'customer.fields.password' | t }}<input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label class="field">{{ 'customer.fields.password_confirm' | t }}<input class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <button class="btn btn--red" type="submit">{{ 'customer.reset.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Nouveau mot de passe", "tag": "section", "class": "section-reset-password", "settings": [] }
{% endschema %}
