{%- assign ss = section.settings -%}
<div class="faq-group" style="--pt: {{ ss.padding_top }}px;">
  <div class="faq-group__inner">
    {%- if ss.heading != blank -%}<h2 class="faq-group__title">{{ ss.heading }}</h2>{%- endif -%}
    <div class="accordion-list">
      {%- for block in section.blocks -%}
        <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if ss.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Groupe de questions",
  "tag": "section",
  "class": "section-faq-group",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Produit & composition" },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus (desktop)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "structured_data", "label": "Données structurées FAQ (SEO)", "default": true }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Les infusions Tisa'nours contiennent-elles du sucre ?" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Aucun sucre ajouté. Nos infusions ne contiennent que des fruits et des plantes bio ; elles contiennent naturellement les sucres présents dans ces fruits. Aucun édulcorant, aucun colorant.</p>" },
      { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
    ] }
  ],
  "presets": [ { "name": "Groupe de questions", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
