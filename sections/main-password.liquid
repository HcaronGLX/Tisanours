<div class="page-section" style="min-height: 70vh; display: flex; align-items: center;">
  <div class="page-section__inner" style="max-width: 640px; text-align: center;">
    <span class="eyebrow">{{ shop.name }}</span>
    <h1 class="page-title" style="margin-top: 14px;">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="page-lead" style="margin-left: auto; margin-right: auto;">{{ shop.password_message }}</p>{%- endif -%}
    <div class="card-box" style="margin-top: 26px; text-align: left;">
      {%- form 'storefront_password', class: 'form' -%}
        {%- if form.errors -%}<div class="form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field">{{ 'general.password_page.password' | t }}<input class="field__input" type="password" name="password" autocomplete="current-password" required></label>
        <button class="btn btn--red" type="submit">{{ 'general.password_page.enter' | t }}</button>
      {%- endform -%}
    </div>
    <p style="margin-top: 18px; font-size: 13px; color: var(--c-text-3);">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Mot de passe",
  "tag": "section",
  "class": "section-password",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Le rituel <em>arrive bientôt</em>" }
  ]
}
{% endschema %}
