{%- liquid
  assign featured = section.settings.product
-%}
{%- if featured != blank -%}
  {%- render 'product-info', product: featured, section: section, title_tag: 'h2', sticky_atc: false -%}
{%- else -%}
  <div class="product product--white u-kit">
    <div class="product__inner">
      <div class="product__media">
        <div class="gallery"><div class="gallery__main ph"></div></div>
      </div>
      <div class="product__info">
        <span class="pi-badge">{{ 'sections.featured_product.placeholder_badge' | t }}</span>
        <h2 class="pi-title">{{ 'sections.featured_product.placeholder_title' | t }}</h2>
        <p class="text-body">{{ 'sections.featured_product.placeholder_text' | t }}</p>
      </div>
    </div>
  </div>
{%- endif -%}

