{%- liquid
  assign ss = section.settings
  assign section_bg = 'var(--c-cream)'
  if ss.background == 'white'
    assign section_bg = 'var(--c-white)'
  endif
-%}
<div class="faq-split" style="--section-bg: {{ section_bg }};">
  <div class="faq-split__inner">
    <div class="faq-split__aside">
      <div class="faq-split__sticky">
        {%- if ss.heading != blank -%}<h2 class="faq-split__title">{{ ss.heading }}</h2>{%- endif -%}
        {%- if ss.text != blank -%}<p class="faq-split__text">{{ ss.text }}</p>{%- endif -%}
        {%- render 'button', label: ss.button_label, link: ss.button_link, style: 'outline-small' -%}
      </div>
    </div>
    <div class="accordion-list">
      {%- for block in section.blocks -%}
        <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- render 'button', label: ss.button_label, link: ss.button_link, style: 'outline-small', class: 'faq-split__mobile-btn' -%}
  </div>
</div>

{%- if ss.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ (avec titre collant)",
  "tag": "section",
  "class": "section-faq-split",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Les questions que se posent <em>les parents</em>" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Tout ce qu'il faut savoir avant de remplacer un jus ou un sirop par une infusion fruitée bio." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir toute la FAQ" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "background", "label": "Fond", "options": [
      { "value": "cream", "label": "Crème" }, { "value": "white", "label": "Blanc" }
    ], "default": "cream" },
    { "type": "checkbox", "id": "structured_data", "label": "Données structurées FAQ (SEO)", "default": false }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "À partir de quel âge ?" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Dès 3 ans. Les infusions sont sans caféine ni théine : elles peuvent se boire le soir sans perturber le sommeil.</p>" },
      { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
    ] }
  ],
  "presets": [
    { "name": "FAQ (avec titre collant)", "blocks": [ { "type": "question" } ] }
  ]
}
{% endschema %}
