<div class="page-section">
  <div class="page-section__inner page-section__inner--narrow">
    {%- if section.settings.show_title -%}
      <h1 class="page-title">{{ page.title | escape }}</h1>
    {%- endif -%}
    <div class="page-body rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Contenu de la page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Afficher le titre", "default": true }
  ]
}
{% endschema %}
