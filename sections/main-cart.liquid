<div class="page-section">
  <div class="page-section__inner page-section__inner--narrow">
    <h1 class="page-title">{{ section.settings.heading }}</h1>
    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p class="page-lead">{{ section.settings.empty_text }}</p>
        {%- render 'button', label: section.settings.empty_button_label, link: section.settings.empty_button_link, style: 'red' -%}
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm">
        <div class="cart-page__lines">
          {%- for item in cart.items -%}
            {%- liquid
              capture lu
                render 'univers', setting: 'auto', product: item.product
              endcapture
              assign lu = lu | strip
            -%}
            <div class="cart-line u-{{ lu }}">
              <a class="cart-line__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="ph" style="display:block;width:100%;height:100%;"></span>{%- endif -%}
              </a>
              <span class="cart-line__info">
                <a class="cart-line__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}<span class="cart-line__plan">{{ item.variant.title }}</span>{%- endunless -%}
                <span class="cart-line__row">
                  <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                  <input class="field__input" style="width: 90px; padding: 8px 12px;" id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                  <span class="cart-line__price">{{ item.final_line_price | money }}</span>
                </span>
                <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </span>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-page__summary card-box">
          {%- render 'cart-tiers' -%}
          {%- if section.settings.show_note -%}
            <label class="field">{{ 'cart.note' | t }}
              <textarea class="field__input cart-note" name="note" rows="3">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}
          <div class="cart-total">
            <span class="cart-total__label">{{ 'cart.total' | t }}</span>
            <span class="cart-total__value">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__note">{{ 'cart.taxes' | t }}</p>
          <button type="submit" name="update" class="btn btn--outline-small">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--red">{{ section.settings.checkout_label }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Panier",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Mon panier" },
    { "type": "textarea", "id": "empty_text", "label": "Texte panier vide", "default": "Votre panier est vide. Commencez par le Kit Démarrage Rituel : les 3 saveurs, la gourde infuseur et le Petit Guide du Rituel." },
    { "type": "text", "id": "empty_button_label", "label": "Bouton panier vide", "default": "Découvrir le Kit Rituel" },
    { "type": "url", "id": "empty_button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "show_note", "label": "Note de commande", "default": false },
    { "type": "text", "id": "checkout_label", "label": "Texte du bouton de commande", "default": "Passer commande" }
  ]
}
{% endschema %}
