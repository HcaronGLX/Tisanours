{%- comment -%}
  Composer mon pack : l'enfant choisit ses infusions (et la gourde), la réduction grimpe avec le nombre de sachets.
  Les paliers affichés doivent correspondre aux réductions automatiques créées dans Shopify (Remises).
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign tiers = section.blocks | where: 'type', 'tier'
  assign items = section.blocks | where: 'type', 'product'
  assign tier_rotations = '-2deg,1.5deg,-1deg,2deg' | split: ','
-%}
<div class="pack" data-pack data-section-id="{{ section.id }}" data-max="{{ ss.max_items }}" data-min-slots="{{ ss.min_slots }}">
  {%- if ss.show_intro -%}
    <div class="pack-intro has-scallop">
      <div class="pack-intro__inner">
        {%- if ss.badge != blank -%}<span class="pack-intro__badge">{{ ss.badge }}</span>{%- endif -%}
        {%- if ss.heading != blank -%}<h1 class="pack-intro__title">{{ ss.heading }}</h1>{%- endif -%}
        {%- if ss.text != blank -%}<div class="pack-intro__text rte">{{ ss.text }}</div>{%- endif -%}
        {%- if tiers.size > 0 -%}
          <div class="pack-tiers">
            {%- for block in tiers -%}
              <div class="pack-tier" data-pack-tier="{{ block.settings.quantity }}" style="--tier-rot: {{ tier_rotations[forloop.index0] | default: '0deg' }};" {{ block.shopify_attributes }}>
                <span class="pack-tier__qty">{{ block.settings.quantity }} {{ ss.unit_plural }}</span>
                <span class="pack-tier__pct">-{{ block.settings.percent }}%</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if ss.note != blank -%}<p class="pack-intro__note">{{ ss.note }}</p>{%- endif -%}
      </div>
      <div class="scallop" style="--scallop: var(--c-cream);"></div>
    </div>
  {%- endif -%}

  <div class="pack-choose">
    <div class="pack-choose__inner">
      {%- if ss.products_heading != blank -%}<h2 class="pack-choose__title">{{ ss.products_heading }}</h2>{%- endif -%}
      {%- if ss.show_tabs -%}
        <div class="pack-tabs" role="tablist">
          <button type="button" class="pack-tab is-active" data-pack-tab="all" role="tab" aria-selected="true">{{ ss.tab_all }}</button>
          <button type="button" class="pack-tab" data-pack-tab="eligible" role="tab" aria-selected="false">{{ ss.tab_eligible }}</button>
          <button type="button" class="pack-tab" data-pack-tab="other" role="tab" aria-selected="false">{{ ss.tab_other }}</button>
        </div>
      {%- endif -%}

      <div class="pack-grid">
        {%- for block in items -%}
          {%- liquid
            assign bs = block.settings
            assign p = bs.product
            assign variant = p.selected_or_first_available_variant
            capture u
              render 'univers', setting: bs.univers, product: p
            endcapture
            assign u = u | strip
            assign card_title = bs.title | default: p.title
            assign card_image = bs.image | default: variant.featured_image | default: p.featured_image
            assign card_text = bs.text
            if card_text == blank
              assign card_text = p.metafields.custom.accroche.value | default: p.description | strip_html | truncatewords: 18
            endif
          -%}
          <article class="pack-card u-{{ u }}" data-pack-card data-key="{{ block.id }}" data-group="{% if bs.eligible %}eligible{% else %}other{% endif %}" {{ block.shopify_attributes }}>
            <div class="pack-card__media{% if card_image == blank %} ph{% endif %}">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 300px, 50vw', widths: '300, 450, 600', alt: card_title }}
              {%- endif -%}
              <span class="pack-card__count" data-pack-count hidden></span>
            </div>
            <div class="pack-card__body">
              {%- if bs.eyebrow != blank -%}<span class="pack-card__eyebrow">{{ bs.eyebrow }}</span>{%- endif -%}
              <h3 class="pack-card__title">{{ card_title }}</h3>
              {%- if card_text != blank -%}<p class="pack-card__text">{{ card_text }}</p>{%- endif -%}
              {%- if p != blank and bs.show_variants and p.has_only_default_variant == false -%}
                <label class="pack-card__variant">
                  <span class="visually-hidden">{{ p.options.first }}</span>
                  <select data-pack-variant>
                    {%- for v in p.variants -%}
                      <option value="{{ v.id }}" data-price="{{ v.price }}" data-image="{% if v.featured_image %}{{ v.featured_image | image_url: width: 160 }}{% endif %}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}
              <span class="pack-card__price">
                <span data-pack-card-price>{{ variant.price | money }}</span>
                {%- if bs.price_suffix != blank %} {{ bs.price_suffix }}{% endif -%}
              </span>
              {%- if p == blank or variant.available == false -%}
                <button type="button" class="btn btn--univers btn--full pack-card__add" disabled>{{ 'products.product.sold_out' | t }}</button>
              {%- else -%}
                <button type="button" class="btn btn--univers btn--full pack-card__add" data-pack-add>{{ ss.add_label }}</button>
              {%- endif -%}
            </div>
            <script type="application/json" data-pack-item>
              {
                "key": {{ block.id | json }},
                "title": {{ card_title | json }},
                "univers": {{ u | json }},
                "eligible": {{ bs.eligible | json }},
                "variant": {{ variant.id | json }},
                "price": {{ variant.price | json }},
                "image": {% if card_image != blank %}{{ card_image | image_url: width: 160 | json }}{% else %}null{% endif %}
              }
            </script>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="pack-bar" data-pack-bar>
    <div class="pack-bar__inner">
      <div class="pack-bar__status">
        {%- if tiers.size > 0 -%}
          <div class="pack-bar__pills">
            {%- for block in tiers -%}
              <span class="pack-pill" data-pack-tier="{{ block.settings.quantity }}">{{ block.settings.quantity }} {{ ss.unit_plural }} · -{{ block.settings.percent }}%</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <span class="pack-bar__msg" data-pack-msg aria-live="polite"></span>
      </div>
      <div class="pack-bar__slots" data-pack-slots></div>
      <div class="pack-bar__total">
        <span class="pack-bar__prices">
          <span class="pack-bar__now" data-pack-now>{{ 0 | money }}</span>
          <span class="pack-bar__old" data-pack-old></span>
          <span class="pack-bar__save" data-pack-save>{{ ss.no_discount_label }}</span>
        </span>
        <button type="button" class="btn btn--red pack-bar__cta" data-pack-submit disabled>{{ ss.submit_label }}</button>
      </div>
    </div>
    <p class="pack-bar__error" data-pack-error hidden></p>
  </div>

  <script type="application/json" data-pack-config>
    {
      "tiers": [{%- for block in tiers -%}{"quantity": {{ block.settings.quantity | json }}, "percent": {{ block.settings.percent | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "moneyFormat": {{ shop.money_format | json }},
      "unit": {{ ss.unit_singular | json }},
      "units": {{ ss.unit_plural | json }},
      "inPack": {{ ss.in_pack_label | json }},
      "removeLabel": {{ ss.remove_label | json }},
      "saveLabel": {{ ss.save_label | json }},
      "noDiscountLabel": {{ ss.no_discount_label | json }},
      "fullLabel": {{ ss.full_label | json }}
    }
  </script>
</div>

{% schema %}
{
  "name": "Composer mon pack",
  "tag": "section",
  "class": "section-pack",
  "settings": [
    { "type": "header", "content": "Introduction" },
    { "type": "checkbox", "id": "show_intro", "label": "Afficher l'introduction", "default": true },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Pack sur-mesure" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre (H1)", "info": "Le texte en italique est surligné.", "default": "Je compose <em>mon pack</em>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Choisissez les infusions préférées de vos enfants, ajoutez la gourde si besoin, et composez un pack qui leur ressemble. Chacun peut y mettre sa saveur : c'est le début du rituel.</p><p>Plus il y a de sachets dans le pack, plus la réduction grimpe. Elle s'applique automatiquement sur les infusions bio ; la gourde infuseur peut rejoindre le pack, à son prix habituel.</p>" },
    { "type": "text", "id": "note", "label": "Mention sous les paliers", "default": "Réduction appliquée sur les infusions uniquement. La gourde reste à 24,90 €." },
    { "type": "header", "content": "Choix des produits" },
    { "type": "inline_richtext", "id": "products_heading", "label": "Titre", "default": "Choisissez vos <em>produits</em>" },
    { "type": "checkbox", "id": "show_tabs", "label": "Afficher les onglets", "default": true },
    { "type": "text", "id": "tab_all", "label": "Onglet : tout", "default": "Tout voir" },
    { "type": "text", "id": "tab_eligible", "label": "Onglet : produits remisés", "default": "Les infusions" },
    { "type": "text", "id": "tab_other", "label": "Onglet : autres produits", "default": "La gourde" },
    { "type": "text", "id": "add_label", "label": "Bouton des cartes", "default": "Ajouter" },
    { "type": "header", "content": "Barre du pack" },
    { "type": "range", "id": "max_items", "label": "Nombre maximum d'articles", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "min_slots", "label": "Emplacements affichés", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "text", "id": "unit_singular", "label": "Unité (singulier)", "default": "sachet" },
    { "type": "text", "id": "unit_plural", "label": "Unité (pluriel)", "default": "sachets" },
    { "type": "text", "id": "in_pack_label", "label": "Pastille sur les cartes", "info": "[count] est remplacé par la quantité.", "default": "×[count] dans le pack" },
    { "type": "text", "id": "save_label", "label": "Économie", "info": "[percent] est remplacé par la réduction.", "default": "Vous économisez [percent] %" },
    { "type": "text", "id": "no_discount_label", "label": "Sans réduction", "default": "Sans réduction" },
    { "type": "text", "id": "full_label", "label": "Pack complet", "default": "Votre pack est complet" },
    { "type": "text", "id": "remove_label", "label": "Retirer (accessibilité)", "default": "Retirer du pack" },
    { "type": "text", "id": "submit_label", "label": "Bouton d'ajout au panier", "default": "Ajouter au panier" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Palier de réduction",
      "limit": 4,
      "settings": [
        { "type": "paragraph", "content": "Le palier affiché doit correspondre à une réduction automatique dans Shopify (Remises), sur les produits marqués « remisés »." },
        { "type": "range", "id": "quantity", "label": "À partir de (articles remisés)", "min": 2, "max": 12, "step": 1, "default": 2 },
        { "type": "range", "id": "percent", "label": "Réduction", "min": 1, "max": 50, "step": 1, "unit": "%", "default": 5 }
      ]
    },
    {
      "type": "product",
      "name": "Produit",
      "limit": 8,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit", "info": "La variante ajoutée est la première disponible (ex. « 1 sachet »)." },
        { "type": "checkbox", "id": "eligible", "label": "Compte pour la réduction", "default": true },
        { "type": "checkbox", "id": "show_variants", "label": "Choix de la variante (ex. coloris)", "default": false },
        { "type": "select", "id": "univers", "label": "Univers de couleur", "options": [
          { "value": "auto", "label": "Automatique (métachamp custom.univers)" },
          { "value": "kit", "label": "Kit / neutre" },
          { "value": "sunshine", "label": "Tropical Sunshine (jaune)" },
          { "value": "adventure", "label": "Happy Adventure (rouge)" },
          { "value": "forest", "label": "Dream Forest (violet)" },
          { "value": "bottle", "label": "Gourde (vert)" }
        ], "default": "auto" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Par défaut : image du produit." },
        { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
        { "type": "text", "id": "title", "label": "Titre", "info": "Par défaut : titre du produit." },
        { "type": "textarea", "id": "text", "label": "Description", "info": "Par défaut : accroche du produit." },
        { "type": "text", "id": "price_suffix", "label": "Texte après le prix", "default": "le sachet" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Composer mon pack",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 2, "percent": 5 } },
        { "type": "tier", "settings": { "quantity": 3, "percent": 15 } },
        { "type": "tier", "settings": { "quantity": 5, "percent": 20 } },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product", "settings": { "eligible": false, "show_variants": true, "price_suffix": "· hors réduction" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
