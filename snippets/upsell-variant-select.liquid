{%- comment -%}
  Liste des variantes (ex. coloris) du bloc « Produit complémentaire ».
  - product: produit proposé
  - selected: variante sélectionnée
  - label: libellé (par défaut, le nom de l'option : « Coloris »)
  - block_id: identifiant du bloc
  Le bouton « Ajouter » ajoute la variante choisie (theme.js, data-upsell-variant).
{%- endcomment -%}
{%- assign select_id = 'UpsellVariant-' | append: block_id -%}
<label class="upsell__variant" for="{{ select_id }}">
  <span class="upsell__variant-label">{{ label | default: product.options.first }}</span>
  <select id="{{ select_id }}" class="upsell__variant-select" data-upsell-variant>
    {%- for v in product.variants -%}
      {%- assign v_image = v.featured_image | default: product.featured_image -%}
      <option
        value="{{ v.id }}"
        data-price="{{ v.price | money | escape }}"
        {% if v_image != blank %}data-image="{{ v_image | image_url: width: 176 }}"{% endif %}
        {% if v.id == selected.id %}selected{% endif %}
        {% unless v.available %}disabled{% endunless %}
      >{{ v.title | escape }}{% unless v.available %} · {{ 'products.product.sold_out' | t }}{% endunless %}</option>
    {%- endfor -%}
  </select>
</label>
