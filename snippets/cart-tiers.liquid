{%- comment -%}
  Barre des paliers à débloquer (livraison offerte, cadeau…), réglée dans Paramètres du thème > Panier.
  Utilisée par le panier latéral et la page panier.
{%- endcomment -%}
{%- liquid
  assign total = cart.total_price
  assign sep = '§§'
  assign list = ''
  for i in (1..4)
    if i == 1
      assign amount = settings.free_shipping_threshold
    else
      assign key = 'tier_' | append: i | append: '_amount'
      assign amount = settings[key]
    endif
    if amount > 0
      assign k_label = 'tier_' | append: i | append: '_label'
      assign k_short = 'tier_' | append: i | append: '_short'
      assign k_icon = 'tier_' | append: i | append: '_icon'
      assign cents = amount | times: 100 | round
      assign entry = cents | append: '|' | append: settings[k_label] | append: '|' | append: settings[k_short] | append: '|' | append: settings[k_icon]
      assign list = list | append: entry | append: sep
    endif
  endfor
  assign tiers = list | split: sep

  assign max = 0
  assign next_cents = 0
  assign next_label = ''
  assign reached_cents = 0
  assign reached_label = ''
  for tier in tiers
    assign parts = tier | split: '|'
    assign c = parts[0] | plus: 0
    if c > max
      assign max = c
    endif
    if c > total
      if next_cents == 0 or c < next_cents
        assign next_cents = c
        assign next_label = parts[1] | default: parts[2]
      endif
    elsif c >= reached_cents
      assign reached_cents = c
      assign reached_label = parts[2] | default: parts[1]
    endif
  endfor

  assign progress = 100
  if max > 0 and total < max
    assign progress = total | times: 100 | divided_by: max
  endif
-%}
{%- if max > 0 -%}
  {%- liquid
    if next_cents > 0
      assign remaining = next_cents | minus: total | money
      if reached_cents > 0
        assign message = settings.tiers_progress | replace: '[atteint]', reached_label
      else
        assign message = settings.tiers_remaining
      endif
      assign message = message | replace: '[montant]', remaining | replace: '[palier]', next_label
    else
      assign message = settings.tiers_done
    endif
  -%}
  <div class="ship-bar{% if tiers.size > 1 %} ship-bar--tiers{% endif %}">
    <span class="ship-bar__msg">{{ message }}</span>
    <span class="ship-bar__track">
      <span class="ship-bar__fill" style="width: {{ progress }}%;"></span>
      {%- if tiers.size > 1 -%}
        {%- for tier in tiers -%}
          {%- liquid
            assign parts = tier | split: '|'
            assign c = parts[0] | plus: 0
            assign pos = c | times: 100 | divided_by: max
          -%}
          <span class="ship-bar__mark{% if total >= c %} is-reached{% endif %}" style="--pos: {{ pos }}%;" aria-hidden="true">{{ parts[3] | default: '•' }}</span>
        {%- endfor -%}
      {%- endif -%}
    </span>
    {%- if tiers.size > 1 and settings.tiers_show_steps -%}
      <ul class="ship-bar__steps">
        {%- for tier in tiers -%}
          {%- liquid
            assign parts = tier | split: '|'
            assign c = parts[0] | plus: 0
          -%}
          <li class="ship-bar__step{% if total >= c %} is-reached{% endif %}">
            <span class="ship-bar__step-name">{% if total >= c %}✓ {% endif %}{{ parts[2] | default: parts[1] }}</span>
            <span class="ship-bar__step-amount">{{ c | money_without_trailing_zeros }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}
