{%- comment -%} Champs d'adresse client. - form, address {%- endcomment -%}
<label class="field">{{ 'customer.fields.first_name' | t }}<input class="field__input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
<label class="field">{{ 'customer.fields.last_name' | t }}<input class="field__input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
<label class="field">{{ 'customer.fields.company' | t }}<input class="field__input" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label class="field">{{ 'customer.fields.address1' | t }}<input class="field__input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label class="field">{{ 'customer.fields.address2' | t }}<input class="field__input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<label class="field">{{ 'customer.fields.zip' | t }}<input class="field__input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
<label class="field">{{ 'customer.fields.city' | t }}<input class="field__input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
<label class="field">{{ 'customer.fields.country' | t }}
  <select class="field__input" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select>
</label>
<label class="field">{{ 'customer.fields.phone' | t }}<input class="field__input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label style="display: flex; gap: 8px; align-items: center; font-weight: 700;">
  <input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}
</label>
