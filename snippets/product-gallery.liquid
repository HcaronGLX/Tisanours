{%- comment -%}
  Galerie de la fiche produit : image principale et vignettes.
  - product: produit
  - current_variant: variante affichée
  - ss: réglages de la section (gallery_thumbs, gallery_radius, show_empty_thumbs, dashed_placeholders)
  Toutes les images sont en vignettes ; au-delà de « Vignettes visibles », des flèches font défiler (theme.js).
{%- endcomment -%}
{%- liquid
  assign thumbs = ss.gallery_thumbs | default: 4
  assign media_count = product.media.size
-%}
<div class="product__media">
  <div class="gallery" style="--thumbs: {{ thumbs }};{% if ss.gallery_radius %} --gallery-radius: {{ ss.gallery_radius }}px;{% endif %}">
    <div class="gallery__main">
      {%- if media_count > 0 -%}
        {%- for media in product.media -%}
          {%- liquid
            assign is_active = false
            if current_variant.featured_media and current_variant.featured_media.id == media.id
              assign is_active = true
            elsif current_variant.featured_media == blank and forloop.first
              assign is_active = true
            endif
            capture media_alt
              echo media.alt | default: product.title
            endcapture
            assign media_loading = 'lazy'
            if forloop.first
              assign media_loading = 'eager'
            endif
          -%}
          <div class="{% if is_active %}is-active{% endif %}" data-gallery-slide data-media-id="{{ media.id }}">
            {{- media.preview_image | image_url: width: 1600 | image_tag: widths: '540, 720, 900, 1080, 1296, 1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: media_loading, alt: media_alt -}}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="ph is-active" style="width:100%;height:100%;" data-gallery-slide data-media-id="placeholder"></div>
      {%- endif -%}
    </div>

    {%- liquid
      assign real_thumbs = 0
      if media_count > 1
        assign real_thumbs = media_count
      endif
      assign missing = 0
      if ss.show_empty_thumbs and real_thumbs < thumbs
        assign missing = thumbs | minus: real_thumbs
      endif
      assign has_more = false
      if thumbs > 0 and real_thumbs > thumbs
        assign has_more = true
      endif
      assign active_media_id = current_variant.featured_media.id | default: product.media.first.id
    -%}
    {%- if thumbs > 0 and real_thumbs > 0 or missing > 0 -%}
      <div class="gallery__thumbs-wrap{% if has_more %} gallery__thumbs-wrap--arrows{% endif %}">
        {%- if has_more -%}
          <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'products.product.previous_media' | t }}">‹</button>
        {%- endif -%}
        <div class="gallery__thumbs gallery__thumbs--{{ thumbs }}{% if has_more %} gallery__thumbs--scroll{% endif %}" data-gallery-track>
          {%- if real_thumbs > 0 -%}
            {%- for media in product.media -%}
              <button type="button" class="gallery__thumb{% if media.id == active_media_id %} is-active{% endif %}" data-gallery-thumb data-media-id="{{ media.id }}" aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}">
                {{- media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' -}}
              </button>
            {%- endfor -%}
          {%- endif -%}
          {%- if missing > 0 -%}
            {%- for i in (1..missing) -%}
              <span class="gallery__thumb ph ph--sm{% if ss.dashed_placeholders %} ph--dashed{% endif %}" role="presentation"></span>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if has_more -%}
          <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'products.product.next_media' | t }}">›</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
