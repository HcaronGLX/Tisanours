  {
    "name": "Typographie",
    "settings": [
      {
        "type": "header",
        "content": "Polices"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "fredoka_n6",
        "info": "Titres, prix, boutons et noms de produits."
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police des textes",
        "default": "nunito_n4"
      },
      {
        "type": "header",
        "content": "Tailles"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "label": "Taille des textes",
        "min": 12,
        "max": 20,
        "step": 0.5,
        "unit": "px",
        "default": 14,
        "info": "Paragraphes, descriptions, listes, réponses de FAQ, footer… Les petits libellés suivent proportionnellement."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Taille des titres",
        "min": 70,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100,
        "info": "Agrandit ou réduit tous les titres, prix et boutons."
      },
      {
        "type": "header",
        "content": "Police de marque Archie"
      },
      {
        "type": "paragraph",
        "content": "Si vous disposez des fichiers Archie (.woff2), importez-les dans Contenu > Fichiers et collez leurs URL : Archie remplacera alors les polices ci-dessus (Regular pour les textes, Bold pour les titres)."
      },
      {
        "type": "text",
        "id": "font_archie_regular_url",
        "label": "URL du fichier Archie Regular (.woff2)"
      },
      {
        "type": "text",
        "id": "font_archie_bold_url",
        "label": "URL du fichier Archie Bold (.woff2)"
      }
    ]
  },
